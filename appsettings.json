{
  "ConnectionStrings": {
    "GeocodingCache": "Data Source=geocoding-cache.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Nominatim": {
    "BaseUrl": "https://nominatim.openstreetmap.org/",
    "UserAgent": "PosiTraceGeocoderAssessment/1.0 (+https://www.positrace.com/)",
    "MinimumRequestIntervalMilliseconds": 1100,
    "TimeoutSeconds": 15
  },
  "AllowedHosts": "*"
}
